APP_NAME=DecaCore Employee FAQ Backend
ENV=dev
LOG_LEVEL=INFO

# Local mode works immediately. Switch each adapter independently when Azure is ready.
AUTH_MODE=dev
DEV_USER_EMAIL=marietta.baudone@gmail.com
AUTO_SEED=true
DATABASE_URL=sqlite:///./data/decacore.db
RETENTION_DAYS=7
ENABLE_DYNAMIC_WATERMARK=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Microsoft Entra ID (IDs supplied for this project; these are not secrets)
ENTRA_TENANT_ID=0eadb77e-42dc-47f8-bbe3-ec2395e0712c
ENTRA_CLIENT_ID=efccb481-74ba-45b8-940a-fed5dfbec74e
ENTRA_OBJECT_ID=2680dbf6-06a6-44b1-abd5-77f56f5b5fd1
# Usually api://<client-id> after "Expose an API" is configured.
ENTRA_AUDIENCE=api://efccb481-74ba-45b8-940a-fed5dfbec74e

# Storage
STORAGE_BACKEND=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_DOCUMENTS_CONTAINER=documents
AZURE_STORAGE_RECEIPTS_CONTAINER=receipts

# Search
SEARCH_BACKEND=local
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=decacore-hr-policies
AZURE_SEARCH_API_KEY=

# Azure OpenAI / Foundry v1 endpoint
LLM_BACKEND=offline
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Notifications
NOTIFICATION_BACKEND=log
GRAPH_TENANT_ID=0eadb77e-42dc-47f8-bbe3-ec2395e0712c
GRAPH_CLIENT_ID=efccb481-74ba-45b8-940a-fed5dfbec74e
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_USER=
HR_NOTIFICATION_EMAIL=

# Local RAG tuning
LOCAL_SEARCH_TOP_K=5
LOCAL_MIN_SCORE=0.08
